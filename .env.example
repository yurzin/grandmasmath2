# Строка подключения к PostgreSQL.
# Если не задана, в режиме разработки автоматически используется
# встроенный PGlite (файлы хранятся в .data/hub/db/pglite) — реальная
# база данных не требуется.
# Для подключения к настоящему Postgres (локальному или облачному,
# например Neon/Supabase) укажите значение ниже:
DATABASE_URL=postgres://user:password@host:5432/dbname

# Секрет сессий (не короче 32 символов). В dev nuxt-auth-utils создаёт его сам.
NUXT_SESSION_PASSWORD=

# Адрес сайта — для ссылок в письмах и возврата после оплаты.
NUXT_SITE_URL=http://localhost:3000

# Почта для кодов входа. Пусто — в dev код печатается в консоль сервера.
# Пример (Яндекс): smtps://login%40yandex.ru:пароль-приложения@smtp.yandex.ru:465
NUXT_MAIL_SMTP_URL=
NUXT_MAIL_FROM="Сборники ЕГЭ <no-reply@example.ru>"

# ЮKassa (личный кабинет → Интеграция → Ключи API). Пусто — в dev тестовая оплата без ЮKassa.
NUXT_YOOKASSA_SHOP_ID=
NUXT_YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ: пусто — не передавать (самозанятый), on — передавать (ИП с онлайн-кассой ЮKassa).
NUXT_YOOKASSA_RECEIPT=
NUXT_YOOKASSA_VAT_CODE=1
NUXT_YOOKASSA_PAYMENT_SUBJECT=commodity

# Сборка PDF: путь к xelatex (если не в PATH) и папка кэша.
XELATEX_PATH=
PDF_CACHE_DIR=
