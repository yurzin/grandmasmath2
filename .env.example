# Строка подключения к PostgreSQL.
# Если не задана, в режиме разработки автоматически используется
# встроенный PGlite (файлы хранятся в .data/hub/db/pglite) — реальная
# база данных не требуется.
# Для подключения к настоящему Postgres (локальному или облачному,
# например Neon/Supabase) укажите значение ниже:
DATABASE_URL=postgres://user:password@host:5432/dbname
